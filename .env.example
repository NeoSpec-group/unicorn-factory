# ============================================================
# Unicorn Factory — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ============================================================
# Supabase
# ============================================================
# Your Supabase project URL — safe to expose (NEXT_PUBLIC_ prefix intentional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — safe to expose (used client-side for RLS-protected queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — SERVER-SIDE ONLY.
# NEVER prefix with NEXT_PUBLIC_ — this would expose it in the browser bundle.
# Used only in app/api/leads/route.ts to bypass RLS for email_leads inserts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Anthropic
# ============================================================
# Anthropic API key — SERVER-SIDE ONLY.
# NEVER prefix with NEXT_PUBLIC_ — this would expose it in the browser bundle.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: override the model ID without a code change.
# Default: claude-haiku-4-5
# Fallback if claude-haiku-4-5 is unavailable: claude-3-haiku-20240307
ANTHROPIC_MODEL=claude-haiku-4-5

# ============================================================
# Paystack (payments — Ignition)
# ============================================================
# Secret key — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Used for transaction/initialize + verify AND to verify webhook signatures
# (x-paystack-signature = HMAC-SHA512 of the raw body with this key).
PAYSTACK_SECRET_KEY=sk_test_your-key-here

# Public key (test). Not currently required server-side (we use the redirect flow),
# kept for reference / a future inline integration.
PAYSTACK_PUBLIC_KEY=pk_test_your-key-here

# Webhook endpoint: POST /api/paystack/webhook  (event: charge.success)
# Configure it in the Paystack Dashboard → Settings → API Keys & Webhooks.
# Charges are in USD — your Paystack account must have USD/international enabled.
# The webhook URL is NOT an app env var (it's Paystack-dashboard config), but it
# must be a PUBLIC URL that can reach this route:
#   - Local/test (G-10 execution verification): run a tunnel (cloudflared/ngrok)
#     to expose localhost:3000, then set the tunnel's https URL + /api/paystack/webhook
#     as the Paystack test-mode webhook. The tunnel must stay running for
#     charge.success to ever reach this app and flip a project to `paid`.
#   - Production: <your deployed Vercel URL>/api/paystack/webhook.

# ============================================================
# Site URL (auth email-confirmation redirect base)
# ============================================================
# Recommended (not strictly required — the app can derive origin from the
# request), but stabilizes the Supabase email-confirmation redirect base
# across local/preview/production so the "confirm your email" link always
# lands back on the right deployment.
# - Local: http://localhost:3000
# - Vercel preview: the preview deployment URL
# - Production: your production URL
# Must be added to the Supabase Auth "Redirect URLs" allow-list as
# <this value>/auth/callback (see docs/DEPLOY.md).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
