# ============================================================
# Unicorn Factory — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ============================================================
# Supabase
# ============================================================
# Your Supabase project URL — safe to expose (NEXT_PUBLIC_ prefix intentional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — safe to expose (used client-side for RLS-protected queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — SERVER-SIDE ONLY.
# NEVER prefix with NEXT_PUBLIC_ — this would expose it in the browser bundle.
# Used only in app/api/leads/route.ts to bypass RLS for email_leads inserts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Anthropic
# ============================================================
# Anthropic API key — SERVER-SIDE ONLY.
# NEVER prefix with NEXT_PUBLIC_ — this would expose it in the browser bundle.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: override the model ID without a code change.
# Default: claude-haiku-4-5
# Fallback if claude-haiku-4-5 is unavailable: claude-3-haiku-20240307
ANTHROPIC_MODEL=claude-haiku-4-5

# ============================================================
# Stripe (payments — Ignition)
# ============================================================
# Secret key — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_your-key-here

# Webhook signing secret — from `stripe listen` (local) or the Dashboard webhook.
# Endpoint: POST /api/stripe/webhook  (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
